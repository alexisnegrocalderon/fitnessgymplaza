# Variables de entorno de Plaza Fitness.
# Copia este archivo a .env (desarrollo local) o cárgalas en Vercel
# (Project Settings → Environment Variables) antes de desplegar.

# ---------------------------------------------------------------------------
# Base de datos (Neon + Drizzle)
# ---------------------------------------------------------------------------
# La integración Neon↔Vercel no siempre publica el mismo nombre de variable
# (ver server/db.ts) — con que exista UNA de estas cuatro alcanza. En
# desarrollo local, DATABASE_URL es la más simple.
DATABASE_URL="postgresql://usuario:password@host/dbname?sslmode=require"
# POSTGRES_URL=
# DATABASE_URL_UNPOOLED=
# POSTGRES_URL_NON_POOLING=

# ---------------------------------------------------------------------------
# Panel de administración (/admin)
# ---------------------------------------------------------------------------
ADMIN_EMAIL="dueno@plazafitness.cl"
ADMIN_PASSWORD="una-clave-larga-y-única"
# Secreto para firmar la cookie de sesión del admin (server/lib/adminAuth.ts).
# Generar uno propio, por ejemplo: openssl rand -base64 48
# Nunca reutilizar este mismo valor para otra cosa (ver §4 del plan: la
# futura sesión de alumno debe usar un secreto distinto).
ADMIN_JWT_SECRET="genera-un-valor-aleatorio-largo"

# ---------------------------------------------------------------------------
# Mercado Pago — Marketplace/OAuth Connect (server/lib/mercadopago.ts)
# ---------------------------------------------------------------------------
# Credenciales de TU aplicación de Mercado Pago (no de la cuenta de Plaza
# Fitness) — se obtienen en https://www.mercadopago.cl/developers/panel
MP_CLIENT_ID="1234567890123456"
MP_CLIENT_SECRET="tu-client-secret"
# URL de callback del flujo OAuth — debe coincidir exactamente con la
# registrada en el panel de desarrolladores de Mercado Pago.
MP_REDIRECT_URI="https://plazafitness.cl/api/admin/mercadopago/callback"
# Secreto del webhook (Tus integraciones → Webhooks → clic en el ojo junto a
# "Clave secreta"). Se usa para verificar la firma x-signature en
# api/mercadopago/webhook.ts — sin esto el webhook rechaza toda notificación.
MP_WEBHOOK_SECRET="el-secreto-que-mercado-pago-te-muestra-en-el-panel"

# ---------------------------------------------------------------------------
# Email transaccional (server/lib/resend.ts)
# ---------------------------------------------------------------------------
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# Remitente verificado en Resend. Si se omite, cae a
# "Plaza Fitness <invitaciones@plazafitness.cl>".
RESEND_FROM_EMAIL="Plaza Fitness <invitaciones@plazafitness.cl>"

# ---------------------------------------------------------------------------
# Analytics (opcional — umami, ver client/index.html)
# ---------------------------------------------------------------------------
# VITE_ANALYTICS_ENDPOINT="https://tu-instancia-umami.example.com"
# VITE_ANALYTICS_WEBSITE_ID="uuid-del-sitio-en-umami"

# ---------------------------------------------------------------------------
# Estándar de Node/Vercel
# ---------------------------------------------------------------------------
NODE_ENV="development"
# PORT=3000   # solo lo usa `pnpm dev` (servidor Express local), Vercel la
#             # asigna sola en producción.

# ---------------------------------------------------------------------------
# Andamiaje heredado de la plantilla Manus (server/_core/*, NO usado por la
# app real de Plaza Fitness — login de admin, /planes e /inauguracion no
# dependen de nada de esto). Se documentan solo para que `tsc` no truene si
# alguna vez se ejecuta ese código muerto; no hace falta configurarlas.
# ---------------------------------------------------------------------------
# BUILT_IN_FORGE_API_KEY=
# BUILT_IN_FORGE_API_URL=
# JWT_SECRET=
# OAUTH_SERVER_URL=
# OWNER_OPEN_ID=
# VITE_APP_ID=
